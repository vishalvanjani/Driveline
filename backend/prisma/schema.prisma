generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite" // swap to "postgresql" and change DATABASE_URL to use Postgres
  url      = env("DATABASE_URL")
}

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  passwordHash String
  role         String     @default("USER") // "USER" | "ADMIN"
  createdAt    DateTime   @default(now())
  purchases    Purchase[]
}

model Vehicle {
  id        String     @id @default(uuid())
  make      String
  model     String
  category  String
  price     Float
  quantity  Int        @default(0)
  year      Int?
  vin       String?
  mileage   Int?
  fuelType  String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  purchases Purchase[]
}

/// Audit trail of customer purchases (sales). Preserves transactional stock decrement.
model Purchase {
  id        String   @id @default(uuid())
  userId    String
  vehicleId String
  pricePaid Float?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
}

/// Persistent audit trail of dealership operational activities.
model ActivityLog {
  id        String   @id @default(uuid())
  action    String   // "CREATED" | "UPDATED" | "DELETED" | "PURCHASED" | "RESTOCKED"
  details   String
  userId    String?
  vehicleId String?
  createdAt DateTime @default(now())
}
